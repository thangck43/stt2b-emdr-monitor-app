{
  "manifest_version": 3,
  "name": "Company Portal DLP Agent",
  "version": "1.0.0",
  "description": "Giám sát đăng nhập portal và kiểm soát download theo chính sách công ty.",
  "permissions": ["downloads", "storage", "notifications", "tabs", "alarms", "identity", "identity.email"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "storage": { "managed_schema": "managed_schema.json" },
  "options_page": "options.html",
  "action": { "default_popup": "popup.html", "default_title": "Portal DLP Agent" },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
